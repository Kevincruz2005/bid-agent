# BID Protocol ACH-LA Agent — Environment Variables
# ─────────────────────────────────────────────────
# After first local registration, the agent prints AGENT_STATE=<base64>.
# Copy that one line and set it in your Railway service. That is all you need.

AGENT_

# ── Alternative: individual vars (use EITHER AGENT_STATE or these, not both) ──
AGENT_NAME=
AGENT_PK=
AGENT_ADDRESS=
TRADING_SAFE=
TREASURY_SAFE=
ROLES_MOD=

# ── First-run only (not needed after registration) ────────────────────────────
USER_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1aWQiOjEyNiwidXNlcm5hbWUiOiJjcmVhdG9yXzAwYzM0NGZjIiwiaWF0IjoxNzgwMjIxMTg3LCJleHAiOjE3ODAzMDc1ODd9.qpoOXksobxIvV8K1To7OPjMA0Zt_Sbzce1iZbxohU6U

# ── Optional overrides ────────────────────────────────────────────────────────
ARCHETYPE=Custom
